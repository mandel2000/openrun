# OpenRun configuration. Copy to `.env` and fill in what you need:
#   cp .env.example .env
# docker compose reads it automatically; ./run.sh does too (see run.sh).
# Every variable is optional unless marked REQUIRED.

# --- Access -------------------------------------------------------------------
# REQUIRED on a server: initial password of the admin account (12+ characters).
# Change it later in Settings > Your account. On your own computer (./run.sh on
# localhost) it can stay empty: requests from the same machine are trusted.
OPENRUN_PASSWORD=
# Username of the admin account (created on first start).
OPENRUN_ADMIN_USER=admin
# 1 = anyone can sign up; 0 (default) = invitation links only (Settings > Users).
OPENRUN_OPEN_SIGNUP=0
# Public address when running on a server, e.g. https://run.example.com
OPENRUN_PUBLIC_URL=
# Server-wide API token (32+ chars) that acts as the admin. Optional: every user can
# create a personal token for the MCP server in Settings > Coach.
OPENRUN_API_TOKEN=
# 1 = "Try the demo" on the sign-in screen (shared sample account, reset daily).
OPENRUN_DEMO=0
# Default language (en | es) for users who haven't picked one in Settings.
OPENRUN_LANG=en

# --- AI coach inside the app ----------------------------------------------------
# anthropic | nvidia | gemini | groq | openrouter | openai | ollama
OPENRUN_PROVIDER=nvidia
NVIDIA_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Override the provider's default model / add fallbacks (comma separated).
OPENRUN_MODEL=
OPENRUN_MODEL_FALLBACKS=
# Any other OpenAI-compatible endpoint: base URL + key.
OPENRUN_BASE_URL=
OPENRUN_API_KEY=
# Daily AI requests per user (admins: unlimited). Editable per user in Settings > Users.
OPENRUN_AI_DAILY_LIMIT=40

# --- Notifications ----------------------------------------------------------------
# Contact sent to browser push services. VAPID keys are generated automatically.
OPENRUN_VAPID_SUB=mailto:you@example.com

# --- Storage ------------------------------------------------------------------------
# SQLite in the data folder by default; or e.g. postgresql+psycopg://user:pass@host:5432/openrun
OPENRUN_DATABASE_URL=
# Time zone used for the daily routine (06:30 by default, configurable in the app).
TZ=Europe/Madrid

# --- Local network (./run.sh only) ----------------------------------------------------
# OPENRUN_HOST=0.0.0.0 makes the app reachable from your phone on the same wifi;
# then a PIN is required.
OPENRUN_HOST=127.0.0.1
OPENRUN_PIN=
